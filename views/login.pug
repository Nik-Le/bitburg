extends layout
block scripts
  script.
    script(src="/js/login.js" defer type="module")
block content
  .container#loginRegistercont
    form#frmLogin.authDesign
      Legend Login
      label(for="username") Benutzername
      input#username(type="text" name="username" placeholder="Benutzername" required)
      label(for="password") Passwort
      input#password(type="password" name="password" required placeholder="Passwort")
      #error-message.alert.alert-danger(style="display: none; color: red; padding: 10px; margin-bottom: 15px;")
      button(type="submit") Einloggen
