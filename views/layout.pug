doctype html
block vars 

html(lang="de")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title #{title} | BitBurg – herrlich herb, unknackbar stark
    link(rel="stylesheet" href="/css/style.css")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css")
    link(rel="icon" type="image/png" href="/images/BitBurg_logo.png")
    script(src="/js/main.js" defer)
    block scripts
  body(id=bodyId)
    header.navbar
      div.container
        #logo-section
          a.logo(href="/")
            img(src="/images/BitBurg_logo.png" alt="BitBurg Logo")
            span.logo-text BitBurg
        
        nav
          ul.nav-links
            li: a(href="/wallet") Wallet
            li: a(href="#") Passwort-Generator

        div.auth-buttons
          a.login-btn(href="#") Über Uns
          a.cta-btn(href="/register") Konto erstellen
          a.profil(href="/login")
            i#user-icon.fas.fa-user.user-icon
            span.profile-text Profil

    main(id=mainId)
      block content                     

    footer
      div.container
        p &copy; 2026 Bitburg Manager. Alle Rechte vorbehalten.