extends layout

block scripts
  script(src="/js/hacker-effect.js" defer)
  script(src="/js/carousel.js" defer)

block content
  section.hero
    div.container.hero-content
      h1.hacker-effect(data-value="Deine digitale Festung") Deine digitale Festung
      p.hero-subtext
        | Speichere, teile und verwalte deine sensiblen Daten mit BitBurg. 
        | Open Source, Ende-zu-Ende verschlüsselt und überall verfügbar.
      div.hero-actions
        a.cta-btn.large(href="/register") Kostenlos starten
  // Neue Bewertungs-Sektion (ersetzt die Hero-Sektion)
  section.reviews-section
    h1 Was unsere Nutzer sagen

    // Container für das horizontale Scrollen
    .reviews-container
      .review-card
        .stars ★★★★★
        p.review-text "BitBurg ist der beste Passwortmanager, den ich je benutzt habe. Super sicher und extrem einfach zu bedienen!"
        p.review-author - Max Mustermann

      .review-card
        .stars ★★★★★
        p.review-text "Endlich muss ich mir nicht mehr hunderte Passwörter merken. Absolut empfehlenswert und das Design ist top."
        p.review-author - Laura Schmidt
      .review-card
        .stars ★★★★★
        p.review-text "Endlich ein Passwortmanager, dem ich wirklich vertraue. BitBurg macht das Verwalten meiner Konten zum absoluten Kinderspiel."
        p.review-author - Julia S.

      .review-card
          .stars ★★★★★
          p.review-text "Die Autofill-Funktion spart mir jeden Tag so viel Zeit. Absolut empfehlenswert für jeden, der online viele Logins hat."
          p.review-author - Tobias M.

      .review-card
          .stars ★★★★☆
          p.review-text "Funktioniert nahtlos auf meinem Handy und am Laptop. Ein Stern Abzug, weil ich mir für die Zukunft noch ein paar mehr Ordner-Funktionen wünsche, ansonsten top!"
          p.review-author - Sarah K.

      .review-card
          .stars ★★★★★
          p.review-text "Bin vor einem Monat von einem anderen Anbieter zu BitBurg gewechselt und bereue es keine Sekunde. Besser und übersichtlicher als die teure Konkurrenz."
          p.review-author - Anja L.

      .review-card
          .stars ★★★★★
          p.review-text "Das Design ist modern und aufgeräumt. Keine überladenen Menüs, sondern einfach genau das, was man im Alltag braucht."
          p.review-author - Leon W.

      .review-card
          .stars ★★★★★
          p.review-text "Mir war besonders wichtig, dass meine Daten verschlüsselt und sicher sind. BitBurg liefert genau das. Super schnelle Einrichtung!"
          p.review-author - Michael B.

      .review-card
          .stars ★★★★☆
          p.review-text "Sehr intuitiv zu bedienen, auch für Leute, die technisch nicht so extrem versiert sind. Habe es direkt auch für meine Eltern eingerichtet."
          p.review-author - Elena R.

      .review-card
          .stars ★★★★★
          p.review-text "Super schnell und die UI hängt sich nie auf. Vor allem der integrierte Passwort-Generator erstellt richtig starke Keys in Sekunden."
          p.review-author - Felix H.

      .review-card
          .stars ★★★★★
          p.review-text "Ein absolutes Must-have! Ohne BitBurg wäre ich im täglichen Internet-Wahnsinn mit den hunderten Passwörtern komplett aufgeschmissen."
          p.review-author - Christian F.

      .review-card
          .stars ★★★★★
          p.review-text "Ich liebe die Karteikarten-Ansicht für meine Zugangsdaten! Das Flippen der Karten sieht nicht nur cool aus, sondern ist mega praktisch."
          p.review-author - Lisa D.

      .review-card
        .stars ★★★★☆
        p.review-text "Sehr gutes Tool. Die Wallet-Funktion ist super praktisch und die Verschlüsselung gibt mir ein sicheres Gefühl."
        p.review-author - Jonas Müller

      .review-card
        .stars ★★★★★
        p.review-text "Ich liebe die Effekte auf der Seite! Abgesehen davon ein sehr zuverlässiger und sicherer Manager für meine Daten."
        p.review-author - Sarah K.

      .review-card
        .stars ★★★★★
        p.review-text "Der Wechsel zu BitBurg ging super schnell. Kann es jedem nur ans Herz legen, der seine Daten schützen will."
        p.review-author - Thomas B.

  section.features
    div.container
      h2 Warum BitBurg?
      div.feature-grid
        article.feature-card
          h3 Zero-Knowledge
          p Wir können deine Daten nicht lesen. Nur du hast den Schlüssel.
        article.feature-card
          h3 Synchronisierung
          p Zugriff von jedem Gerät: iOS, Android, Web und Desktop.
        article.feature-card
          h3 Open Source
          p Transparenz schafft Vertrauen. Unser Code ist öffentlich prüfbar.