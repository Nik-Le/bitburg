extends layout

//- Hier setzen wir die ID für den Body dieser speziellen Seite
block vars
  - var bodyId = 'walletBody';
  - var mainId = 'walletMain';
block scripts
  script.
    const isPremiumUser = !{user && user.premiumuser ? 'true' : 'false'};
  script(src="/js/wallet.js" defer type="module")

block append nav-actions 
  a#logout-img.logout(href="/#")
    img(src="/images/logout.jpg" alt="logout")
  label#logoutCountdown.logoutCntdwnLbl Logout in
  

    

block content
  #wallet-container
    .spacer
    ul#password-container
      each entry in passwordList
        li.password-card
          div.inner-card
            div.card-front <strong>#{entry.siteName}</strong>
              button.setting-btn.fa-solid.fa-edit(type="Button" )
              div.dropdown.is-hidden
                button.delete-entry-btn(type="Button" data-id=entry._id) Löschen
            div.card-back <p><strong>Eintrags-name:</strong> #{entry.siteName} </p><strong>Benutzername/E-Mail: </strong>#{entry.userName} </p><p><strong>Passwort: </strong>#{entry.password}</p>
      else
        li.password-card Keine Einträge vorhanden!   
    button#add-button.fa-solid.fa-plus
  form#frmPopup.is-hidden()
    label(for="name-input") Name:
    input#name-input.inputbox(name="siteName" type="text" placeholder="google.com")
    span#name-error.error-txt.is-hidden Länge muss mindestens 8 Zeichen lang sein.
    
    label(for="username-input") Benutzername/Email:
    input#username-input.inputbox(name="userName" type="text" placeholder="MaxMustermann@mail.de")
    span#username-error.error-txt.is-hidden Länge muss mindestens 8 Zeichen lang sein.
    
    label(for="password-input") Passwort:
    #password-group
      input#password-input.inputbox(name="password" type="password" placeholder="12345678")
      button#copy-password(type="button")
        i.fa-solid.fa-clone
      button#password-generator(type="button")
        i.fa-solid.fa-wand-magic-sparkles
    span#password-error.error-txt.is-hidden Länge muss mindestens 8 Zeichen lang sein.
    
    #button-container
      button#cancel-button(type="button") Abbrechen
      button#submit-entry-button(type="submit") Hinzufuegen

  //- Formular: Generator
  form#generator.is-hidden
    input#generated-password.inputbox(type="text", readonly)
    
    .generator-options
      .option-row
        label(for="pw-length") Length
        input#pw-length(type="number" min=8 max=20 value=8 ) 
        span#length-error.error-txt.is-hidden Länge muss mindestens 8 Zeichen lang sein.
      
      .option-row
        label(for="up-case" ) A-Z
        input#up-case(type="checkbox" checked="true")
      
      .option-row
        label(for="low-case") a-z
        input#low-case(type="checkbox" checked="true")
      
      .option-row
        label(for="numbers") 0-9
        input#numbers(type="checkbox" checked="true")

      .option-row
        label(for="symbols") $!?
        input#symbols(type="checkbox" checked="true")
    
    button#generate-btn(type="button") Passwort generieren
    p#premium-feedback(style="color: red; margin-top: 5px; font-weight: bold;")
    button#apply-btn(type="button") Passwort übernehmen
    button#cancel-generation-btn(type="button") Abbrechen
